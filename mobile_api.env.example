# Production mobile/backend settings. Never commit real tokens or credentials.
# Public DNS name pointed at the machine running docker-compose.production.yml.
TRADE_DOMAIN=

# Generate at least 32 random characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
MOBILE_API_TOKEN=
MOBILE_API_DB_PATH=data/trading_bot.db
MOBILE_DASHBOARD_URL=

# Server-side push notifications. The API observes durable state and notifies
# registered iPhones about engine state changes, safety locks, and new fills.
MOBILE_PUSH_ENABLED=true
MOBILE_PUSH_POLL_SECONDS=10
# Optional only when Expo push security is enabled for the EAS project.
EXPO_ACCESS_TOKEN=

# Native iOS requests do not require CORS. Add comma-separated origins only if
# you intentionally run an Expo web build against this API.
MOBILE_ALLOWED_ORIGINS=
