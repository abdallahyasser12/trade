# Alpaca paper credentials. The stock engine is always paper-only; crypto also
# defaults to paper. Get these from Alpaca -> Paper Trading -> API Keys.
#
# SECURITY NOTE: a real paper key pair was committed to this file in the past
# (git history commit dc516a8). Those keys must be treated as compromised —
# revoke and regenerate them in the Alpaca dashboard. Never commit .env.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=

# Existing installations may keep using these legacy PAPER aliases instead:
# ALPACA_API_KEY=PKJM6LRXB3AJXVDF6KLGJ2GRIY
# ALPACA_SECRET_KEY=9RDhQLMhFsFMJDqDSRZ5EKFckH5AAsfkGGXKZ35BZXMB

# Crypto live trading is disabled unless this exact feature flag is enabled.
# Live mode additionally requires the dashboard acknowledgement, typed LIVE
# confirmation, exact endpoint/account verification, and hard risk caps.
ENABLE_LIVE_TRADING=false

# Never put paper keys in these variables. Leave them blank unless you have
# deliberately enabled and independently reviewed crypto live trading.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=

# Standalone iOS / production backend. TRADE_DOMAIN must resolve publicly to
# the machine running docker-compose.production.yml for Caddy HTTPS.
TRADE_DOMAIN=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MOBILE_API_TOKEN=
MOBILE_PUSH_ENABLED=true
MOBILE_PUSH_POLL_SECONDS=10
# Optional only when Expo push security is enabled for the EAS project.
EXPO_ACCESS_TOKEN=
# Native iOS does not need CORS. Only set this for a browser/web client.
MOBILE_ALLOWED_ORIGINS=
