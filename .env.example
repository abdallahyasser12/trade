# Alpaca PAPER trading credentials.
# Get these from the Alpaca dashboard -> Paper Trading -> API Keys.
# Use PAPER keys only — this application never connects to live trading,
# but do not paste live-account keys here anyway.
#
# Copy this file to .env and fill in the values. Never commit .env.
# NOTE: a real key pair was committed to this file in the past (git
# history commit dc516a8). Those keys must be treated as compromised —
# revoke and regenerate them in the Alpaca dashboard.

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
