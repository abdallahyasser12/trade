# ---------------------------------------------------------------------------
# Bybit Spot Demo — primary operator dashboard
# ---------------------------------------------------------------------------
# Preferred setup: leave these blank, open Dashboard -> SETTINGS, paste your Bybit
# Demo key/secret, and click Test & Save. The dashboard stores them in its isolated
# server-side credential vault instead of this file.
#
# Optional fallback for deployment-managed secrets only:
# Create credentials from Bybit Demo Trading, not Testnet and not a live account.
# Grant only the read/trade permissions needed for Spot Demo operation.
# DO NOT grant withdrawal permission.
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=

# Future live credentials are intentionally separate and unused by the current
# production operator path. Leave blank. BYBIT LIVE construction remains disabled.
BYBIT_LIVE_API_KEY=
BYBIT_LIVE_API_SECRET=

# ---------------------------------------------------------------------------
# Existing Alpaca workflows — preserved for paper/research regression
# ---------------------------------------------------------------------------
# Alpaca paper credentials. The stock engine is paper-only by default and the
# existing Alpaca crypto workflow remains available under Advanced / Research.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=

# Existing installations may keep using these legacy PAPER aliases instead:
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=

# Existing guarded Alpaca crypto live functionality is separate from Bybit and is
# disabled unless explicitly enabled. The Bybit Demo dashboard never flips this.
ENABLE_LIVE_TRADING=false
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Production dashboard / mobile API
# ---------------------------------------------------------------------------
# TRADE_DOMAIN must resolve publicly to the host running docker compose.
TRADE_DOMAIN=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MOBILE_API_TOKEN=
MOBILE_PUSH_ENABLED=true
MOBILE_PUSH_POLL_SECONDS=10
# Optional only when Expo push security is enabled for the EAS project.
EXPO_ACCESS_TOKEN=
# Native iOS does not need CORS. Only set this for a browser/web client.
MOBILE_ALLOWED_ORIGINS=
